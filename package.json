{
  "name": "zenn-content",
  "version": "1.0.0",
  "description": "Zenn記事管理リポジトリ",
  "private": true,
  "scripts": {
    "new": "zenn new:article",
    "preview": "zenn preview",
    "new:book": "zenn new:book",
    "lint": "npm run lint:text && npm run lint:md && npm run lint:secret",
    "lint:text": "textlint 'articles/**/*.md'",
    "lint:text:fix": "textlint --fix 'articles/**/*.md'",
    "lint:md": "markdownlint-cli2 'articles/**/*.md'",
    "lint:secret": "secretlint '**/*'",
    "prepare": "lefthook install",
    "qiita:convert": "node .github/scripts/convert-to-qiita.js --all --dry-run",
    "qiita:post": "node .github/scripts/post-to-qiita.js --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.4.0",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.1.4",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.1",
    "secretlint": "^11.4.0",
    "textlint": "^15.5.2",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "twitter-api-v2": "^1.29.0",
    "zenn-cli": "^0.4.6"
  }
}
